# ---- Database paths (SQLite) ----------------------------------------------
ICICI_XIRR_DB_PATH=sqlite:///data/xirr.sqlite3
ICICI_MARKET_DATA_DB_PATH=data/market_data.sqlite3
ICICI_RESEARCH_DB_PATH=sqlite:///data/research.sqlite3
ICICI_DECISION_DB_PATH=sqlite:///data/decisions.sqlite3
ICICI_MF_ANALYTICS_DB_PATH=sqlite:///data/mf_analytics.sqlite3
ICICI_SCHEDULER_DB_PATH=sqlite:///data/scheduler.sqlite3
ICICI_ALERTS_DB_PATH=sqlite:///data/alerts.sqlite3
ICICI_USAGE_DB_PATH=sqlite:///data/usage.sqlite3

# ---- Market data price fallback (Yahoo Finance) ----------------------------
# Fetch prices on demand when the local market-data DB has no close for a date
# (historical XIRR periods, current dates after the last bulk import).
ICICI_PRICE_FETCH_FALLBACK=true
ICICI_PRICE_FETCH_PERSIST=true
# Max distinct securities fetched per price-lookup instance (0 = unlimited).
ICICI_PRICE_FETCH_MAX_SYMBOLS=10
# Provider preference: auto | yfinance | yahoo_chart
# auto = yfinance library first, then the Yahoo chart HTTP API (no extra deps).
ICICI_PRICE_PROVIDER=auto

# ---- LLM providers (research only; never accounting) -----------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# ---- Stage 10: automation, security & monitoring ---------------------------
# Encryption key for backups (Fernet base64 key OR a passphrase; derived if not base64)
BACKUP_ENCRYPTION_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=text

# Optional authentication (disabled by default). Enable for shared deployments.
APP_AUTH_ENABLED=false
APP_USERNAME=
APP_PASSWORD=
# Prefer hashed: APP_PASSWORD_SHA256=<hex sha256 of password>
APP_ROLE=admin
